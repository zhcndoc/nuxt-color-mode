FROM --platform=$BUILDPLATFORM node:24-bookworm AS builder

WORKDIR /app

ENV CI=true

RUN corepack enable pnpm

COPY . .

RUN pnpm install --frozen-lockfile

RUN pnpm run prepack && pnpm run docs:build

FROM ikxin/caddy:latest

COPY --from=builder /app/docs/.output/public /usr/share/caddy

EXPOSE 8080
